# CupNight Circuit — Environment Variables (.env.example)
# Copy as .env and fill in values before running locally.

# ─── Blockchain (Base Sepolia Testnet) ──────────────────
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
WALLET_PRIVATE_KEY=your_wallet_private_key_here  # DO NOT COMMIT this!
CUPNIGHT_CONTRACT_ADDRESS=0x...  # Deployed from CupNightOracle.sol
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913  # Base USDC address

# ─── Telegram Bot (Hermes Oracle) ──────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_api_token
TELEGRAM_API_ID=your_telegram_api_id
TELEGRAM_API_HASH=your_telegram_api_hash

# ─── WhatsApp Mirror (Optional) ─────────────────────────
WHATSAPP_PHONE_NUMBER=+XX...  # For pywhatkit outbound messages only
WABA_ACCESS_TOKEN=  # Use official WA Business API for inbound DMs

# ─── Hermes Oracle / Admin Vault ────────────────────────
HERMES_ORACLE_WALLET_ADDR=0x...  # Wallet that calls confirmWinner()
PLATFORM_ADMIN_KEY=optional_admin_key_for_manual_review

# ─── Frontend (Next.js 14+) ────────────────────────────
NEXT_PUBLIC_CUPNIGHT_CONTRACT_ADDRESS=0x...  # Matches CUPNIGHT_CONTRACT_ADDRESS
NEXT_PUBLIC_USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913   # Base USDC

# ─── Cloudflare / Deployment (for DNS + Worker routing) ─
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token  # For Workers/DNS management
CLOUDFLARE_ACCOUNT_ID=your_account_id
VERCEL_ORG_ID=optional_vercel_org_id
VERCEL_PROJECT_ID=optional_vercel_project_id

# ─── Social / Virality Bot ──────────────────────────────
TWITTER_API_KEY=your_twitter_api_key
TWITTER_API_SECRET=your_twitter_api_secret
YOUTUBE_API_KEY=your_youtube_api_key

# ─── Database (Supabase) ───────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key  # Keep secret!
